# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
# Supabase Dashboard -> Project Settings -> API

# Safe to expose to the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Scraper only (scraper/.env locally, GitHub Actions secrets in CI).
# service_role bypasses RLS entirely — server-side only, never in the web app.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP — an App Password, not your account password.
# https://myaccount.google.com/apppasswords (needs 2FA enabled)
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
